@page
@model AspNetCoreVerifiableCredentials.Pages.TechVerificationModel
@{
    ViewData["Title"] = "Helpdesk Identity Verification";
}

<div id="wrap">
    <div style="text-align: center;">
        VerifiedCredentialExpert-icon.png
        <h1>Helpdesk Identity Verification</h1>

        @if (!Model.Started)
        {
            <p>
                Enter the ticket details below, then start a Verified ID presentation request for the caller.
            </p>

            <form method="post" style="display: inline-block; text-align: left; min-width: 420px;">
                <div style="margin-bottom: 15px;">
                    <label for="TicketNumber">Ticket Number</label><br />
                    <input type="text"
                           id="TicketNumber"
                           name="TicketNumber"
                           value="@Model.TicketNumber"
                           style="width: 100%;"
                           placeholder="INC123456" />
                </div>

                <div style="margin-bottom: 15px;">
                    <label for="CallerName">Caller Name or Username</label><br />
                    <input type="text"
                           id="CallerName"
                           name="CallerName"
                           value="@Model.CallerName"
                           style="width: 100%;"
                           placeholder="Caller name or username" />
                </div>

                <div style="margin-bottom: 15px;">
                    <label for="Reason">Reason for Verification</label><br />
                    <input type="text"
                           id="Reason"
                           name="Reason"
                           value="@Model.Reason"
                           style="width: 100%;"
                           placeholder="Password reset identity verification" />
                </div>

                <button type="submit" class="button">Start Verification</button>
                <button type="button" class="button" onclick="window.location='Index'">Cancel</button>
            </form>

            @if (!ViewData.ModelState.IsValid)
            {
                <div style="color: red; margin-top: 20px;">
                    Please enter a ticket number before starting verification.
                </div>
            }
        }
        else
        {
            <h2>Verification request started</h2>

            <div style="display: inline-block; text-align: left; margin-bottom: 25px;">
                <p><strong>Ticket Number:</strong> @Model.TicketNumber</p>
                <p><strong>Caller Name or Username:</strong> @Model.CallerName</p>
                <p><strong>Reason:</strong> @Model.Reason</p>
            </div>

            <div id="message-wrapper" class="margin-bottom-75">
                <i class="fas fa-user-check green icon-text-large margin-bottom-25"></i>
                <div id="message">Creating verification request...</div>
                <br />
            </div>

            <div id="qrcode" style="text-align:center; display:none;"></div>

            <br />

            <button type="button" id="check-result" class="button" style="display:none">Check Result</button>
            <button type="button" class="button" onclick="window.location='TechVerification'">Start Another</button>

            <script src="qrcode.min.js"></script>
            <script src="verifiedid.requestservice.client.js"></script>
            <script src="verifiedid.uihandler.js"></script>

            <script>
                var qrcode = new QRCode("qrcode", { width: 150, height: 150 });

                document.addEventListener('DOMContentLoaded', () => {
                    requestService.apiCreatePresentationRequest += '?faceCheck=0';
                    requestService.createPresentationRequest();
                });

                document.getElementById('check-result').addEventListener('click', () => {
                    requestService.pollRequestStatus(requestService.request.id);
                });
            </script>
        }
    </div>
</div>
