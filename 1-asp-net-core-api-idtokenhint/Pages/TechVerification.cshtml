@page
@model AspNetCoreVerifiableCredentials.Pages.TechVerificationModel
@{
    ViewData["Title"] = "Helpdesk Identity Verification";
}

<div id="wrap">
    <div style="text-align: center;">
        <img src="VerifiedCredentialExpert
        <h1>Helpdesk Identity Verification</h1>

        @if (!Model.Started)
        {
            <p>
                Enter the ticket details below to create a customer verification session.
            </p>

            <form method="post" style="display: inline-block; text-align: left; min-width: 420px;">

                <div style="margin-bottom: 15px;">
                    <label for="TicketNumber">Ticket Number</label><br />
                    <input type="text"
                           id="TicketNumber"
                           name="TicketNumber"
                           value="@Model.TicketNumber"
                           style="width:100%;"
                           placeholder="INC123456" />
                </div>

                <div style="margin-bottom: 15px;">
                    <label for="CallerName">Caller Name or Username</label><br />
                    <input type="text"
                           id="CallerName"
                           name="CallerName"
                           value="@Model.CallerName"
                           style="width:100%;"
                           placeholder="Caller name or username" />
                </div>

                <div style="margin-bottom: 15px;">
                    <label for="Reason">Reason for Verification</label><br />
                    <input type="text"
                           id="Reason"
                           name="Reason"
                           value="@Model.Reason"
                           style="width:100%;"
                           placeholder="Password reset identity verification" />
                </div>

                <button type="submit" class="button">
                    Create Verification Session
                </button>

                <button type="button"
                        class="button"
                        onclick="window.location='Index'">
                    Cancel
                </button>

            </form>
        }
        else
        {
            <h2>Verification Session Created</h2>

            <div style="display:inline-block;text-align:left;margin-bottom:25px;">
                <p>
                    <strong>Ticket Number:</strong>
                    @Model.TicketNumber
                </p>

                <p>
                    <strong>Caller Name or Username:</strong>
                    @Model.CallerName
                </p>

                <p>
                    <strong>Reason:</strong>
                    @Model.Reason
                </p>
            </div>

            <br />

            <div style="margin:20px;">

                <h3>Customer Verification Link</h3>

                <input type="text"
                       id="verificationUrl"
                       value="@Model.VerificationUrl"
                       readonly
                       style="width:600px;" />

                <br /><br />

                <button type="button"
                        class="button"
                        onclick="copyVerificationUrl()">
                    Copy Link
                </button>

            </div>

            <br />

            <div>
                <h3>Verification Status</h3>

                <div id="verificationStatus">
                    Waiting for customer...
                </div>
            </div>

            <br />

            <button type="button"
                    class="button"
                    onclick="window.location='TechVerification'">
                Start Another
            </button>

            <script>
                function copyVerificationUrl() {
                    var textbox = document.getElementById("verificationUrl");

                    textbox.select();
                    textbox.setSelectionRange(0, 99999);

                    navigator.clipboard.writeText(textbox.value);

                    alert("Verification link copied");
                }
            </script>
        }
    </div>
</div>
